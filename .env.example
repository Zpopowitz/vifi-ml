# Copy this file to `.env` and fill in real secrets BEFORE
# `docker compose up -d`. NEVER commit `.env` -- it contains secrets.
#
# Generate values with:
#   python -c "from security import generate_api_key; print(generate_api_key())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -hex 32

# --- Identity -------------------------------------------------------------
VIFI_PATIENT_ID=default

# --- API authentication ---------------------------------------------------
# The code default is api_key (fail-closed): if this file is missing or
# the variable is unset, the API refuses to boot until keys are
# configured, instead of serving open. Dev runs must EXPLICITLY set
# VIFI_AUTH_MODE=none (warns at boot). Production: api_key + keys below.
VIFI_AUTH_MODE=api_key
# Comma-separated literal keys (simplest setup). Generate with:
#   python -c "from security import generate_api_key; print(generate_api_key())"
VIFI_API_KEYS=
# OR: path to a JSON file with per-key metadata (preferred for prod).
# Format:
#   {"vifi_<token>": {"name": "alice", "scopes": ["read"],
#                      "expires_at": "2027-01-01T00:00:00Z",
#                      "revoked": false}}
# Both ENV and FILE keys are merged; revoked + expired are filtered.
VIFI_API_KEYS_FILE=

# --- Trusted proxies (for X-Forwarded-For + rate limit per-client) --------
# Comma-separated CIDRs of upstream proxies whose XFF is trustworthy.
# Empty = trust no proxies; rate limiter sees only the immediate peer.
# When fronted by Caddy on the same host, this is usually 127.0.0.1/32.
VIFI_TRUSTED_PROXIES=

# --- CORS -----------------------------------------------------------------
# Comma-separated origins for the dashboard's HTTP requests to the API.
# Empty = no cross-origin requests (default, safest).
VIFI_CORS_ORIGINS=

# --- Rate limit -----------------------------------------------------------
VIFI_RATE_LIMIT=60/minute

# --- Error redaction ------------------------------------------------------
# "true" exposes internal stack traces in 5xx responses (dev only).
VIFI_REVEAL_ERRORS=false

# --- OpenAPI docs ----------------------------------------------------------
# "true" registers /docs, /redoc, /openapi.json (still behind auth in
# api_key mode). Default false: the full API schema is an attacker's
# sitemap and has no business on a patient-monitoring device.
VIFI_EXPOSE_DOCS=false

# --- HIPAA Safe Harbor pseudonymization ------------------------------------
# Required in production. >= 32 chars; openssl rand -hex 32
VIFI_PSEUDO_SALT=
# "true" (the code default, fail-closed) refuses to write audit records
# when the salt is missing. "false" is a dev-only opt-out that writes
# clearly-marked "pseudo-dev:<id>" identifiers -- never use it with
# real patient data.
VIFI_REQUIRE_PSEUDO=true

# --- Audit log encryption -------------------------------------------------
# Fernet key (base64, generated by Fernet.generate_key()). Plaintext when
# unset (dev only).
VIFI_AUDIT_ENCRYPTION_KEY=
# HMAC chain key — tamper detection on the audit log. Without it the log
# is still pseudonymized + optionally encrypted but a deletion or
# reorder is undetectable. Generate: openssl rand -hex 32
VIFI_AUDIT_CHAIN_KEY=
# fsync each audit write (the code default) -- durability under power
# loss. At the ~0.5 Hz HR/RR audit write rate the ~10x slowdown is
# irrelevant; only set "false" for dev/test runs with write-heavy
# audit volume where durability does not matter.
VIFI_AUDIT_FSYNC=true
# Audit log directory inside the audit_subscriber container.
VIFI_AUDIT_DIR=/app/data/audit

# --- Redis ----------------------------------------------------------------
# Production must set VIFI_REDIS_PASSWORD. Two bus URLs because
# containers and the host loggers reach Redis through different names:
#  * VIFI_BUS_URL_INTERNAL : used inside the compose network (service
#    name `redis`). Containers default to redis://redis:6379/0 if
#    this is unset; override here to inject a password.
#  * VIFI_BUS_URL          : used by HOST loggers (csi_capture.py,
#    hr_logger.py, rr_logger.py) running outside compose. They reach
#    Redis at localhost.
VIFI_REDIS_PASSWORD=
VIFI_BUS_URL_INTERNAL=redis://redis:6379/0
VIFI_BUS_URL=redis://localhost:6379/0
VIFI_REDIS_PORT=6379

# --- Public-facing TLS (prod profile only) --------------------------------
# Domain Caddy terminates TLS for. Caddy auto-provisions a Let's Encrypt
# cert for any DNS name resolving to this host.
VIFI_DOMAIN=localhost
