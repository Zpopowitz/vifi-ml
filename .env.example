# Copy this file to `.env` and fill in real secrets BEFORE
# `docker compose up -d`. NEVER commit `.env` -- it contains secrets.
#
# Generate values with:
#   python -c "from security import generate_api_key; print(generate_api_key())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -hex 32

# --- Identity -------------------------------------------------------------
VIFI_PATIENT_ID=default

# --- API authentication ---------------------------------------------------
# Production must use api_key. Dev runs may use "none" (warns at boot).
VIFI_AUTH_MODE=none
# Comma-separated. Generate one per client. Rotate quarterly.
VIFI_API_KEYS=

# --- CORS -----------------------------------------------------------------
# Comma-separated origins for the dashboard's HTTP requests to the API.
# Empty = no cross-origin requests (default, safest).
VIFI_CORS_ORIGINS=

# --- Rate limit -----------------------------------------------------------
VIFI_RATE_LIMIT=60/minute

# --- Error redaction ------------------------------------------------------
# "true" exposes internal stack traces in 5xx responses (dev only).
VIFI_REVEAL_ERRORS=false

# --- HIPAA Safe Harbor pseudonymization ------------------------------------
# Required in production. >= 32 chars; openssl rand -hex 32
VIFI_PSEUDO_SALT=
# "true" to refuse to write audit records when the salt is missing.
VIFI_REQUIRE_PSEUDO=false

# --- Audit log encryption -------------------------------------------------
# Fernet key (base64, generated by Fernet.generate_key()). Plaintext when
# unset (dev only).
VIFI_AUDIT_ENCRYPTION_KEY=

# --- Redis ----------------------------------------------------------------
# Production must set VIFI_REDIS_PASSWORD. Two bus URLs because
# containers and the host loggers reach Redis through different names:
#  * VIFI_BUS_URL_INTERNAL : used inside the compose network (service
#    name `redis`). Containers default to redis://redis:6379/0 if
#    this is unset; override here to inject a password.
#  * VIFI_BUS_URL          : used by HOST loggers (csi_capture.py,
#    hr_logger.py, rr_logger.py) running outside compose. They reach
#    Redis at localhost.
VIFI_REDIS_PASSWORD=
VIFI_BUS_URL_INTERNAL=redis://redis:6379/0
VIFI_BUS_URL=redis://localhost:6379/0
VIFI_REDIS_PORT=6379

# --- Public-facing TLS (prod profile only) --------------------------------
# Domain Caddy terminates TLS for. Caddy auto-provisions a Let's Encrypt
# cert for any DNS name resolving to this host.
VIFI_DOMAIN=localhost
