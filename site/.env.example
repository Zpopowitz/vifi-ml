# Required for /admin (Decap CMS) GitHub OAuth login.
# Set both as Vercel project Environment Variables.
# See README.md → "CMS / OAuth setup (one-time)" for how to obtain them.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Formspree form ID for the /pilots inquiry form.
# Create a form at https://formspree.io and paste the ID here (the part
# after /f/ in the form's submit URL). Set the same value in Vercel
# project Environment Variables. Without it, the form falls back to a
# mailto link to the pilot inbox.
PUBLIC_FORMSPREE_PILOTS_ID=

# Formspree form ID for the /contact form (separate form from /pilots
# so submissions don't mix). Same setup as PUBLIC_FORMSPREE_PILOTS_ID.
PUBLIC_FORMSPREE_CONTACT_ID=
