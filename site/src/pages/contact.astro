---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const landing = await getEntry("landing", "main");
const c = landing.data;

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID;
const formAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : null;

const reasons = [
  "Investor inquiry",
  "Press / media",
  "Technical review",
  "Research collaboration",
  "General question",
  "Other",
];

const meta = {
  title: "Contact | ViFi",
  description:
    "Get in touch with ViFi. For investor inquiries, press, technical review, research collaborations, or general questions about contactless WiFi-based patient monitoring.",
};
---

<Layout title={meta.title} description={meta.description}>
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="subpage-hero">
      <div class="container container-prose">
        <p class="eyebrow">Contact</p>
        <h1 class="display">Get in&nbsp;touch.</h1>
        <p class="intro">
          For investor questions, press, technical review, or research
          collaborations. If you're a hospital or health-system partner
          interested in a pilot, the
          <a href="/pilots" class="inline-link">pilot inquiry form</a>
          is the right place to start.
        </p>
      </div>
    </section>

    <!-- ============ FORM ============ -->
    <section class="contact-form-section" aria-labelledby="form-heading">
      <div class="container">
        <div class="section-grid">
          <header class="section-header">
            <p class="section-eyebrow">Send a note</p>
            <h2 id="form-heading" class="section-heading">A few sentences will do.</h2>
          </header>
          <div class="section-body">
            {formAction ? (
          <form action={formAction} method="POST" class="editorial-form">
            <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_subject" value="ViFi contact inquiry" />

            <p class="required-note">Fields marked <span class="req">*</span> are required.</p>

            <div class="field-row">
              <label class="field">
                <span class="field-label">Your name <span class="req" aria-hidden="true">*</span></span>
                <input type="text" name="name" required aria-required="true" autocomplete="name" />
              </label>
              <label class="field">
                <span class="field-label">Email <span class="req" aria-hidden="true">*</span></span>
                <input type="email" name="email" required aria-required="true" autocomplete="email" inputmode="email" />
              </label>
            </div>

            <label class="field">
              <span class="field-label">Reason for contacting <span class="req" aria-hidden="true">*</span></span>
              <select name="reason" required aria-required="true">
                <option value="" disabled selected>Select one…</option>
                {reasons.map((r) => <option value={r}>{r}</option>)}
              </select>
            </label>

            <label class="field">
              <span class="field-label">Note <span class="req" aria-hidden="true">*</span></span>
              <textarea name="note" rows="6" required aria-required="true" autocomplete="off" placeholder="A few sentences about what's on your mind."></textarea>
            </label>

            <div class="submit-row">
              <button type="submit" class="btn btn-primary">Send message →</button>
              <p class="legal-note">
                By submitting you agree to ViFi's
                <a href="/privacy">Privacy Policy</a> and
                <a href="/terms">Terms of Use</a>.
              </p>
            </div>
          </form>
        ) : (
          <div class="email-fallback">
            <p>
              The contact form is being set up. In the meantime, email
              <a href={`mailto:${c.links.contact_email}`}>{c.links.contact_email}</a>
              and we'll get back to you.
            </p>
            <a href={`mailto:${c.links.contact_email}`} class="btn btn-primary">
              Email us →
            </a>
          </div>
        )}

            {c.links.linkedin && (
              <p class="aside">
                You can also follow ViFi on
                <a href={c.links.linkedin} target="_blank" rel="noopener" class="inline-link">LinkedIn</a>.
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
  .container-prose { max-width: 720px; }

  /* ============ ASYMMETRIC 2-COL GRID (matches SubpageLayout) ============ */
  .section-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
  }
  .section-header { position: sticky; top: 88px; }
  .section-body { max-width: 720px; }

  /* ============ HERO ============ */
  .subpage-hero { padding: 100px 0 80px; }
  .eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 28px;
  }
  h1.display {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(40px, 5.5vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.024em;
    color: var(--ink);
    max-width: 14ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 144;
    margin: 0 0 28px 0;
  }
  .intro {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    text-wrap: pretty;
    margin: 0;
  }
  .inline-link {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    transition: text-decoration-color 180ms;
  }
  .inline-link:hover { text-decoration-color: var(--accent); }
  .inline-link:visited { color: var(--accent-visited); }

  /* ============ FORM SECTION ============ */
  .contact-form-section {
    padding: 80px 0;
    border-top: 1px solid var(--rule);
  }
  .section-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin: 0 0 16px 0;
  }
  /* Sized for the 320px left rail (matches SubpageLayout). */
  h2.section-heading {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 48;
    margin: 0;
  }

  /* ============ FORM ============ */
  .editorial-form { margin: 0; }
  .honeypot { display: none; }
  .required-note {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--muted);
    margin: 0 0 24px 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .req { color: var(--accent); font-weight: 600; }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }
  .field { display: block; margin-bottom: 24px; }
  .field:last-of-type { margin-bottom: 0; }
  .field-row .field { margin-bottom: 0; }
  .field-label {
    display: block;
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .field input,
  .field textarea,
  .field select {
    width: 100%;
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 12px 14px;
    transition: border-color 180ms ease-out, background-color 180ms ease-out;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--muted);
    font-style: italic;
  }
  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--paper);
  }
  .field input:focus-visible,
  .field textarea:focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .field textarea {
    resize: vertical;
    font-family: "Source Serif 4", Georgia, serif;
  }

  .submit-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .btn {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 4px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--paper);
    cursor: pointer;
    transition: background-color 180ms, border-color 180ms;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
  }
  .btn:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .legal-note {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 13px;
    color: var(--muted);
    margin: 0;
    max-width: 40ch;
  }
  .legal-note a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .legal-note a:hover { text-decoration-color: var(--accent); }

  .email-fallback {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 32px;
  }
  .email-fallback p {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 24px 0;
    max-width: 60ch;
  }
  .email-fallback p a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .email-fallback p a:hover { text-decoration-color: var(--accent); }

  .aside {
    font-family: "Source Serif 4", Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--muted);
    margin: 56px 0 0 0;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 960px) {
    .container { padding: 0 32px; }
    .section-grid { grid-template-columns: 280px 1fr; gap: 48px; }
  }
  @media (max-width: 760px) {
    .container { padding: 0 20px; }
    .section-grid { grid-template-columns: 1fr; gap: 24px; }
    .section-header { position: static; }
    .section-body { max-width: 100%; }
  }
  @media (max-width: 600px) {
    .subpage-hero { padding: 56px 0 48px; }
    .contact-form-section { padding: 56px 0; }
    .field-row { grid-template-columns: 1fr; gap: 0; }
    .field-row .field { margin-bottom: 24px; }
  }
</style>
