---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const entry = await getEntry("landing", "main");
const c = entry.data;
---

<Layout title={c.meta.title} description={c.meta.description}>
  <a href="#main" class="skip-link">Skip to content</a>

  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="ambient-trace" aria-hidden="true">
        <svg viewBox="0 0 2400 280" preserveAspectRatio="none" focusable="false"
             role="img"
             aria-label="Synthesized waveform: respiration (~0.23 Hz) plus cardiac perturbations (~1.2 Hz), representative of what ViFi measures via WiFi CSI">
          <path d="M 0.0 91.1 L 10.0 87.7 L 20.0 84.5 L 30.0 81.8 L 40.0 79.3 L 50.0 77.3 L 60.0 75.7 L 70.0 74.4 L 80.0 73.5 L 90.0 73.0 L 100.0 72.8 L 110.0 72.9 L 120.0 73.3 L 130.0 73.9 L 140.0 74.6 L 150.0 75.4 L 160.0 76.3 L 170.0 77.2 L 180.0 78.1 L 190.0 78.9 L 200.0 79.5 L 210.0 79.9 L 220.0 80.2 L 230.0 80.2 L 240.0 79.9 L 250.0 79.4 L 260.0 78.5 L 270.0 77.4 L 280.0 76.1 L 290.0 74.5 L 300.0 72.7 L 310.0 70.7 L 320.0 68.6 L 330.0 66.4 L 340.0 64.2 L 350.0 62.0 L 360.0 59.9 L 370.0 57.8 L 380.0 56.0 L 390.0 54.4 L 400.0 53.1 L 410.0 52.0 L 420.0 51.4 L 430.0 51.1 L 440.0 51.2 L 450.0 51.7 L 460.0 52.6 L 470.0 53.9 L 480.0 55.6 L 490.0 57.7 L 500.0 60.1 L 510.0 62.9 L 520.0 65.9 L 530.0 69.1 L 540.0 72.5 L 550.0 76.0 L 560.0 79.6 L 570.0 83.1 L 580.0 86.6 L 590.0 90.1 L 600.0 93.3 L 610.0 96.4 L 620.0 99.2 L 630.0 101.8 L 640.0 104.1 L 650.0 106.1 L 660.0 107.8 L 670.0 109.2 L 680.0 110.3 L 690.0 111.2 L 700.0 111.8 L 710.0 112.2 L 720.0 112.4 L 730.0 112.5 L 740.0 112.5 L 750.0 112.5 L 760.0 112.5 L 770.0 112.6 L 780.0 112.9 L 790.0 113.3 L 800.0 113.9 L 810.0 114.8 L 820.0 115.9 L 830.0 117.4 L 840.0 119.2 L 850.0 121.4 L 860.0 123.9 L 870.0 126.8 L 880.0 130.0 L 890.0 133.5 L 900.0 137.2 L 910.0 141.2 L 920.0 145.4 L 930.0 149.8 L 940.0 154.2 L 950.0 158.7 L 960.0 163.2 L 970.0 167.6 L 980.0 171.8 L 990.0 175.9 L 1000.0 179.7 L 1010.0 183.3 L 1020.0 186.6 L 1030.0 189.5 L 1040.0 192.1 L 1050.0 194.3 L 1060.0 196.1 L 1070.0 197.6 L 1080.0 198.7 L 1090.0 199.4 L 1100.0 199.8 L 1110.0 199.9 L 1120.0 199.8 L 1130.0 199.4 L 1140.0 198.9 L 1150.0 198.3 L 1160.0 197.6 L 1170.0 197.0 L 1180.0 196.4 L 1190.0 195.9 L 1200.0 195.5 L 1210.0 195.3 L 1220.0 195.4 L 1230.0 195.7 L 1240.0 196.2 L 1250.0 197.0 L 1260.0 198.2 L 1270.0 199.5 L 1280.0 201.2 L 1290.0 203.1 L 1300.0 205.2 L 1310.0 207.4 L 1320.0 209.9 L 1330.0 212.3 L 1340.0 214.9 L 1350.0 217.4 L 1360.0 219.8 L 1370.0 222.2 L 1380.0 224.3 L 1390.0 226.2 L 1400.0 227.9 L 1410.0 229.2 L 1420.0 230.2 L 1430.0 230.8 L 1440.0 231.0 L 1450.0 230.8 L 1460.0 230.2 L 1470.0 229.1 L 1480.0 227.7 L 1490.0 225.9 L 1500.0 223.8 L 1510.0 221.3 L 1520.0 218.6 L 1530.0 215.6 L 1540.0 212.5 L 1550.0 209.3 L 1560.0 206.0 L 1570.0 202.7 L 1580.0 199.4 L 1590.0 196.2 L 1600.0 193.2 L 1610.0 190.4 L 1620.0 187.8 L 1630.0 185.4 L 1640.0 183.3 L 1650.0 181.5 L 1660.0 180.0 L 1670.0 178.8 L 1680.0 177.9 L 1690.0 177.2 L 1700.0 176.8 L 1710.0 176.5 L 1720.0 176.5 L 1730.0 176.5 L 1740.0 176.6 L 1750.0 176.8 L 1760.0 176.9 L 1770.0 176.9 L 1780.0 176.8 L 1790.0 176.5 L 1800.0 175.9 L 1810.0 175.1 L 1820.0 174.0 L 1830.0 172.6 L 1840.0 170.8 L 1850.0 168.7 L 1860.0 166.2 L 1870.0 163.4 L 1880.0 160.2 L 1890.0 156.7 L 1900.0 153.0 L 1910.0 148.9 L 1920.0 144.7 L 1930.0 140.3 L 1940.0 135.9 L 1950.0 131.3 L 1960.0 126.8 L 1970.0 122.4 L 1980.0 118.0 L 1990.0 113.9 L 2000.0 109.9 L 2010.0 106.2 L 2020.0 102.8 L 2030.0 99.8 L 2040.0 97.1 L 2050.0 94.7 L 2060.0 92.8 L 2070.0 91.2 L 2080.0 89.9 L 2090.0 89.1 L 2100.0 88.5 L 2110.0 88.2 L 2120.0 88.1 L 2130.0 88.3 L 2140.0 88.6 L 2150.0 89.0 L 2160.0 89.4 L 2170.0 89.8 L 2180.0 90.2 L 2190.0 90.5 L 2200.0 90.6 L 2210.0 90.5 L 2220.0 90.2 L 2230.0 89.7 L 2240.0 88.9 L 2250.0 87.8 L 2260.0 86.4 L 2270.0 84.7 L 2280.0 82.8 L 2290.0 80.6 L 2300.0 78.2 L 2310.0 75.7 L 2320.0 73.0 L 2330.0 70.2 L 2340.0 67.3 L 2350.0 64.5 L 2360.0 61.8 L 2370.0 59.2 L 2380.0 56.7 L 2390.0 54.5 L 2400.0 52.5"/>
        </svg>
      </div>

      <div class="container hero-content">
        <h1 class="display wake wake-1">Hospital&#8209;grade vital signs from <em class="soften">$44</em> of WiFi&nbsp;hardware.</h1>

        <div class="container-prose">
          <p class="lede wake wake-2">Continuous bedside monitoring costs $3,000 per room and gets reserved for the ICU. ViFi delivers wellness-grade contactless monitoring for <a class="cite-link" href="#proof-heading">1/68th the cost</a>, validated against a Polar H10 chest-strap at <a class="cite-link" href="#proof-heading">4.15 bpm cross-session MAE</a>.</p>
          <div class="cta-row wake wake-3">
            <a href="/results" class="btn btn-primary">Read the methodology →</a>
            <a href="/pilots" class="btn btn-secondary">Request a pilot kit →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="proof" aria-labelledby="proof-heading" data-animate="up">
      <div class="container">
        <p class="section-eyebrow">{c.proof.eyebrow}</p>
        <h2 id="proof-heading" class="section-heading">{c.proof.heading_line1} <em>{c.proof.heading_line2}</em></h2>
        <p class="section-lede">{c.proof.paragraphs[0]}</p>

        <div class="comparison" role="table" aria-label="Heart-rate accuracy comparison across systems" data-animate-stagger>
          {c.proof.comparison_rows.map((row) => (
            <div class={`comparison-row ${row.highlight ? "featured" : ""}`} role="row">
              <div class="row-name" role="cell">
                {row.highlight
                  ? <span class="featured-mark">{row.system}</span>
                  : <>{row.system}{row.system.startsWith("PhaseBeat") && <span class="cite">INFOCOM '17</span>}</>
                }
              </div>
              <div class="row-hardware" role="cell">{row.hardware}</div>
              <div class="row-cost" role="cell">{row.per_node_cost} / node</div>
              <div class="row-mae" role="cell">{row.mae}</div>
            </div>
          ))}
        </div>

        <p class="comparison-caption">
          ViFi delivers <strong>96%</strong> of PhaseBeat's accuracy at <strong>4.4%</strong> of its cost. Against a clinical bedside monitor, it's <strong>1/136th</strong> the per-room cost.
        </p>

        <p class="results-link">{c.proof.results_link_text.split(":")[0]}: <a href={c.links.results}>read our results →</a></p>
      </div>
    </section>

    <!-- ============ PROBLEM ============ -->
    <section class="problem" aria-labelledby="problem-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.problem.eyebrow}</p>
        <h2 id="problem-heading" class="section-heading">{c.problem.heading}</h2>

        <div class="stat-callout" data-animate-stagger>
          <div class="stat-cell">
            <div class="stat-num">2.3M</div>
            <div class="stat-label">U.S. med-surg<br>+ SNF beds</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">23<span class="stat-unit">hrs/day</span></div>
            <div class="stat-label">patients sit<br>unmonitored</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">4–8<span class="stat-unit">hrs</span></div>
            <div class="stat-label">between<br>nursing rounds</div>
          </div>
        </div>

        <div class="prose">
          {c.problem.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ============ WHY THIS EXISTS ============ -->
    <section class="why" aria-labelledby="why-heading" data-animate="up">
      <div class="container">
        <p class="section-eyebrow" id="why-heading">From the founder</p>
        <figure>
          <blockquote>{c.problem.pullquote}</blockquote>
          <figcaption>Zach Popowitz · founder</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="how" aria-labelledby="how-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.how_it_works.eyebrow}</p>
        <h2 id="how-heading" class="section-heading">{c.how_it_works.heading}</h2>
        <p class="section-lede">{c.how_it_works.intro}</p>

        <pre class="diagram" aria-label="Signal path diagram: ESP32-S3 transmitter sends 192 subcarriers across the room to the ESP32-S3 receiver; chest motion perturbs the path; data flows over USB serial at 921600 baud through csi_capture.py to first_capture_report.py, producing HR and RR predictions validated against Polar H10 ground truth"
>{c.how_it_works.diagram}</pre>

        <h3 class="subsection-heading">{c.how_it_works.signal_path_title}</h3>
        <ol class="pipeline" data-animate-stagger>
          {c.how_it_works.signal_path_steps.map((step) => <li>{step}</li>)}
        </ol>

        <h3 class="subsection-heading">{c.how_it_works.prior_art_title}</h3>
        <p class="prose-paragraph">{c.how_it_works.prior_art}</p>
      </div>
    </section>

    <!-- ============ ROADMAP ============ -->
    <section class="roadmap" aria-labelledby="roadmap-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.roadmap.eyebrow}</p>
        <h2 id="roadmap-heading" class="section-heading">{c.roadmap.heading}</h2>
        <p class="section-lede">{c.roadmap.intro}</p>

        <ol class="timeline" data-animate-stagger>
          {c.roadmap.steps.map((step) => (
            <li>
              <p class="step-date">{step.date}</p>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </li>
          ))}
        </ol>

        <p class="results-link" style="margin-top: 48px;">
          <a href={c.links.roadmap}>{c.roadmap.live_manifest_text} →</a>
        </p>
      </div>
    </section>

    <!-- ============ PILOT CTA ============ -->
    <section class="pilot-cta" aria-labelledby="pilot-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.hospitals.eyebrow}</p>
        <h2 id="pilot-heading" class="section-heading">{c.hospitals.heading}</h2>
        <div class="prose">
          {c.hospitals.intro_paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="pilot-bullets" data-animate-stagger>
          {c.hospitals.pilot_bullets.map((b) => <li>{b}</li>)}
        </ul>
        <a href="/pilots" class="btn btn-primary" style="margin-top: 8px;">{c.hospitals.cta}</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* ============ ENTRANCE ============ */
  @keyframes wake {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .wake { opacity: 0; animation: wake 1.2s cubic-bezier(.2,.6,.2,1) forwards; }
  .wake-1 { animation-delay: 0.05s; }
  .wake-2 { animation-delay: 0.35s; }
  .wake-3 { animation-delay: 0.6s; }

  /* Fraunces SOFT-axis morph on entrance (variable-font signature move) */
  @keyframes soft-morph {
    from { font-variation-settings: "SOFT" 30,  "opsz" 144; }
    to   { font-variation-settings: "SOFT" 100, "opsz" 144; }
  }
  .soften { animation: soft-morph 0.8s cubic-bezier(.3,.6,.2,1) 0.7s both; }

  @media (prefers-reduced-motion: reduce) {
    .wake { animation: none; opacity: 1; transform: none; }
    .soften { animation: none; font-variation-settings: "SOFT" 100, "opsz" 144; }
  }

  /* ============ LAYOUT ============ */
  .container { max-width: 1160px; margin: 0 auto; padding: 0 32px; }
  .container-prose { max-width: 720px; padding: 0; }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding: 96px 0 80px;
    overflow: hidden;
  }
  .ambient-trace {
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 200px;
    pointer-events: none;
    z-index: 0;
    opacity: var(--trace-opacity);
  }
  .ambient-trace svg { width: 100%; height: 100%; display: block; }
  .ambient-trace path {
    stroke: var(--trace);
    stroke-width: 1.0;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hero-ecg-sweep 14s linear infinite;
    animation-delay: 1.2s;
  }
  @keyframes hero-ecg-sweep {
    0%   { stroke-dashoffset: 100; opacity: 1; }
    82%  { stroke-dashoffset: 0;   opacity: 1; }
    94%  { stroke-dashoffset: 0;   opacity: 1; }
    100% { stroke-dashoffset: 0;   opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-trace path { animation: none; stroke-dashoffset: 0; opacity: 0.55; }
  }

  .hero-content { position: relative; z-index: 1; }

  h1.display {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(40px, 5.8vw, 76px);
    line-height: 1.03;
    letter-spacing: -0.024em;
    color: var(--ink);
    /* 22ch lets text-wrap: balance land on 2 lines at desktop widths
       (e.g. "Hospital-grade vital signs / from $44 of WiFi hardware.")
       instead of the awkward 3-line break at 16ch. */
    max-width: 22ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 144;
    /* Tightened from 260px so primary CTAs sit above the fold on
       1440×900. The ambient waveform still has room (it lives in the
       absolute-positioned .ambient-trace, centered vertically). */
    margin: 0 0 180px 0;
  }
  h1.display em {
    font-style: italic;
    font-weight: 500;
    color: var(--ink);
  }

  .lede {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 44px 0;
    text-wrap: pretty;
  }

  .cite-link {
    color: inherit;
    text-decoration: underline dotted var(--rule);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 220ms ease-out, color 220ms ease-out;
  }
  .cite-link:hover, .cite-link:focus-visible {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }
  .cite-link:visited { color: inherit; }
  .cite-link:visited:hover { color: var(--accent-visited); }

  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 4px;
    transition: background-color 180ms ease-out, color 180ms ease-out, border-color 180ms ease-out;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
  }
  .btn-primary { background: var(--accent); color: var(--paper); border: 1px solid var(--accent); }
  .btn-primary:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .btn-secondary { background: transparent; color: var(--accent); border: 1px solid transparent; }
  .btn-secondary:hover { color: var(--accent-2); }
  .btn-secondary:visited { color: var(--accent-visited); }

  /* ============ PROOF ============ */
  .proof {
    padding: 120px 0;
    border-top: 1px solid var(--rule);
  }
  .section-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 32px;
  }
  h2.section-heading {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 96;
    margin: 0 0 40px 0;
  }
  h2.section-heading em {
    font-style: italic;
    font-weight: 500;
    color: var(--muted);
    font-variation-settings: "SOFT" 100, "opsz" 96;
  }
  .section-lede {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 72px 0;
    text-wrap: pretty;
  }

  .comparison { margin: 0 0 56px 0; }
  .comparison-row {
    display: grid;
    grid-template-columns: 2fr 2fr 1.2fr 1.2fr;
    gap: 24px;
    align-items: baseline;
    padding: 28px 24px;
    border-bottom: 1px solid var(--rule);
    transition: background-color 180ms ease-out;
    margin: 0 -24px;
  }
  .comparison-row:hover { background: var(--row-hover); }
  .comparison-row:first-child { border-top: 1px solid var(--rule); }
  .row-name {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30, "opsz" 28;
  }
  .row-name .cite {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--muted);
    margin-left: 8px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .row-hardware {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 15px;
    color: var(--ink-2);
  }
  .row-cost, .row-mae {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 15px;
    color: var(--ink-2);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* Featured row (ViFi) — background fill, accent left stripe, all values
     in ink color so the row reads as THE result, not just one option. */
  .comparison-row.featured {
    background: var(--paper-2);
    position: relative;
  }
  .comparison-row.featured::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
  }
  .comparison-row.featured:hover { background: var(--paper-3); }
  .comparison-row.featured .row-name .featured-mark {
    font-style: italic;
    font-variation-settings: "SOFT" 80, "opsz" 28;
    color: var(--ink);
  }
  .comparison-row.featured .row-hardware,
  .comparison-row.featured .row-mae,
  .comparison-row.featured .row-cost {
    color: var(--ink);
    font-weight: 500;
  }

  .results-link {
    font-family: "Source Serif 4", Georgia, serif;
    font-style: italic;
    font-size: 16px;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .results-link a {
    color: var(--accent);
    text-decoration: none;
    font-style: normal;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 180ms;
  }
  .results-link a:hover { border-bottom-color: var(--accent); }
  .results-link a:visited { color: var(--accent-visited); }

  /* Comparison caption: distills the table's math into one sentence */
  .comparison-caption {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 70ch;
    margin: 32px 0;
    text-wrap: pretty;
  }
  .comparison-caption strong {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Stat callout (Problem section): three big numbers, one row of typography */
  .stat-callout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 40px 0 48px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat-cell {
    padding: 28px 24px 28px 0;
    border-right: 1px solid var(--rule);
  }
  .stat-cell:last-child { border-right: none; padding-right: 0; }
  .stat-cell:nth-child(n+2) { padding-left: 24px; }
  .stat-num {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.022em;
    font-variation-settings: "SOFT" 30, "opsz" 96;
    margin-bottom: 12px;
    font-variant-numeric: tabular-nums;
  }
  .stat-unit {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.34em;
    color: var(--muted);
    margin-left: 6px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
    position: relative;
    top: -0.1em;
  }
  .stat-label {
