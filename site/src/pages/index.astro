---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const entry = await getEntry("landing", "main");
const c = entry.data;

// Ambient hero pattern — multi-strand twisted RF braid. Each strand is
// sign × envelope(x) × sin(carrier × x + phase). Strands come in mirrored
// pairs (sign = ±1) that cross at every zero of the carrier, and several
// pairs at offset phases stack into a dense interwoven braid. The carrier
// period and envelope period both divide VIS_W exactly, so translateX(-VIS_W)
// is a perfect, seam-free loop.
const VIS_W = 2400;
const TOTAL_W = VIS_W * 2;

const CARRIER_K = 8;   // 4 carrier oscillations visible across the hero
const ENVELOPE_K = 4;  // 2 amplitude pulses visible
const CARRIER_AMP = 56;
const ENV_FLOOR = 0.32; // floor keeps amplitude alive at envelope minima

function buildTwistPath(width: number, centerY: number, sign: 1 | -1, phase: number): string {
  const samples = 1400;
  let d = "";
  for (let i = 0; i <= samples; i++) {
    const x = (i / samples) * width;
    const env = ENV_FLOOR + (1 - ENV_FLOOR) * 0.5 *
      (1 + Math.cos((2 * Math.PI * ENVELOPE_K * x) / width));
    const carrier = Math.sin((2 * Math.PI * CARRIER_K * x) / width + phase);
    const y = centerY + sign * CARRIER_AMP * env * carrier;
    const cmd = i === 0 ? "M" : "L";
    d += `${cmd} ${x.toFixed(1)} ${y.toFixed(2)} `;
  }
  return d.trim();
}

const CENTER_Y = 140;

// Four twisted pairs (8 strands) at evenly spaced phase offsets, each rendered
// in its own scroll layer with a coprime-ish duration. Each pair's loop is
// individually seamless (path is periodic, transform shifts by VIS_W); but
// because the pairs scroll at different speeds, the relative phasing between
// them drifts continuously — so the visible braid never reassembles the same
// configuration twice within a reasonable viewing window.
//
// Outer pairs (0, 3) are dim accent-tinted, inner pairs (1, 2) are brighter
// neutral, which gives the braid depth without using --signal (reserved for
// HR/ECG data per DESIGN.md).
type Pair = {
  phase: number;
  color: string;
  opacity: number;
  width: number;
  durationS: number;
  strands: { sign: 1 | -1; d: string }[];
};

const PAIR_CONFIGS = [
  { phase: 0,                  isOuter: true,  durationS: 41 },
  { phase: Math.PI / 4,        isOuter: false, durationS: 53 },
  { phase: Math.PI / 2,        isOuter: false, durationS: 67 },
  { phase: (3 * Math.PI) / 4,  isOuter: true,  durationS: 79 },
];

const pairs: Pair[] = PAIR_CONFIGS.map((p) => ({
  phase: p.phase,
  color: p.isOuter ? "var(--accent)" : "var(--trace)",
  opacity: p.isOuter ? 0.42 : 0.70,
  width: p.isOuter ? 1.1 : 1.3,
  durationS: p.durationS,
  strands: [
    { sign: 1 as const,  d: buildTwistPath(TOTAL_W, CENTER_Y,  1, p.phase) },
    { sign: -1 as const, d: buildTwistPath(TOTAL_W, CENTER_Y, -1, p.phase) },
  ],
}));
---

<Layout title={c.meta.title} description={c.meta.description}>
  <a href="#main" class="skip-link">Skip to content</a>

  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero-content">
        <h1 class="display wake wake-1">Hospital&#8209;grade vital signs from <em class="soften">$44</em> of WiFi&nbsp;hardware.</h1>
      </div>

      {/* Ambient RF braid. Absolutely centered in the hero on desktop;
          dropped into normal flow as its own band on mobile (see the
          760px media query) so it can never cross the headline or lede. */}
      <div class="ambient-trace" aria-hidden="true">
        {pairs.map((p) => (
          <div class="pair-scroller" style={`animation-duration: ${p.durationS}s`}>
            <svg viewBox="0 0 4800 280" preserveAspectRatio="none" focusable="false">
              {p.strands.map((s) => (
                <path d={s.d} style={`stroke: ${p.color}; stroke-width: ${p.width}; opacity: ${p.opacity};`}/>
              ))}
            </svg>
          </div>
        ))}
      </div>

      <div class="container hero-content">
        <div class="container-prose">
          <p class="lede wake wake-2">Continuous bedside monitoring costs $3,000 per room and gets reserved for the ICU. ViFi delivers wellness-grade contactless monitoring for <a class="cite-link" href="#proof-heading">1/68th the cost</a>, validated against a Polar H10 chest-strap at <a class="cite-link" href="#proof-heading">4.15 bpm cross-session MAE</a>.</p>
          <div class="cta-row wake wake-3">
            <a href="/results" class="btn btn-primary">Read the methodology →</a>
            <a href="/pilots" class="btn btn-secondary">Request a pilot kit →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="proof" aria-labelledby="proof-heading" data-animate="up">
      <div class="container">
        <p class="section-eyebrow">{c.proof.eyebrow}</p>
        <h2 id="proof-heading" class="section-heading">{c.proof.heading_line1} <em>{c.proof.heading_line2}</em></h2>
        <p class="section-lede">{c.proof.paragraphs[0]}</p>

        <div class="comparison" role="table" aria-label="Heart-rate accuracy comparison across systems" data-animate-stagger>
          {c.proof.comparison_rows.map((row) => (
            <div class={`comparison-row ${row.highlight ? "featured" : ""}`} role="row">
              <div class="row-name" role="cell">
                {row.highlight
                  ? <span class="featured-mark">{row.system}</span>
                  : <>{row.system}{row.system.startsWith("PhaseBeat") && <span class="cite">INFOCOM '17</span>}</>
                }
              </div>
              <div class="row-hardware" role="cell">{row.hardware}</div>
              <div class="row-cost" role="cell">{row.per_node_cost} / node</div>
              <div class="row-mae" role="cell">{row.mae}</div>
            </div>
          ))}
        </div>

        <p class="comparison-caption">
          ViFi delivers <strong>96%</strong> of PhaseBeat's accuracy at <strong>4.4%</strong> of its cost. Against a clinical bedside monitor, it's <strong>1/136th</strong> the per-room cost.
        </p>

        <aside class="next-read">
          <p class="next-read-context">{c.proof.results_link_text.split(":")[0]}.</p>
          <a class="next-read-link" href={c.links.results}>
            Read our results
            <span class="next-read-arrow" aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </section>

    <!-- ============ PROBLEM ============ -->
    <section class="problem" aria-labelledby="problem-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.problem.eyebrow}</p>
        <h2 id="problem-heading" class="section-heading">{c.problem.heading}</h2>

        <div class="stat-callout" data-animate-stagger>
          <div class="stat-cell">
            <div class="stat-num">2.3M</div>
            <div class="stat-label">U.S. med-surg + SNF beds</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">23<span class="stat-unit">hrs/day</span></div>
            <div class="stat-label">patients sit unmonitored</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">4–8<span class="stat-unit">hrs</span></div>
            <div class="stat-label">between nursing rounds</div>
          </div>
        </div>

        <div class="prose">
          {c.problem.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ============ WHY THIS EXISTS ============ -->
    <section class="why" aria-labelledby="why-heading" data-animate="up">
      <div class="container">
        <p class="section-eyebrow" id="why-heading">From the founder</p>
        <figure>
          <blockquote>{c.problem.pullquote}</blockquote>
          <figcaption>Zach Popowitz · founder</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="how" aria-labelledby="how-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.how_it_works.eyebrow}</p>
        <h2 id="how-heading" class="section-heading">{c.how_it_works.heading}</h2>
        <p class="section-lede">{c.how_it_works.intro}</p>

        <pre class="diagram" aria-label="Signal path diagram: ESP32-S3 transmitter sends 192 subcarriers across the room to the ESP32-S3 receiver; chest motion perturbs the path; data flows over USB serial at 921600 baud through csi_capture.py to first_capture_report.py, producing HR and RR predictions validated against Polar H10 ground truth"
>{c.how_it_works.diagram}</pre>

        <h3 class="subsection-heading">{c.how_it_works.signal_path_title}</h3>
        <ol class="pipeline" data-animate-stagger>
          {c.how_it_works.signal_path_steps.map((step) => <li>{step}</li>)}
        </ol>

        <h3 class="subsection-heading">{c.how_it_works.prior_art_title}</h3>
        <p class="prose-paragraph">{c.how_it_works.prior_art}</p>
      </div>
    </section>

    <!-- ============ ROADMAP ============ -->
    <section class="roadmap" aria-labelledby="roadmap-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.roadmap.eyebrow}</p>
        <h2 id="roadmap-heading" class="section-heading">{c.roadmap.heading}</h2>
        <p class="section-lede">{c.roadmap.intro}</p>

        <ol class="timeline" data-animate-stagger>
          {c.roadmap.steps.map((step) => (
            <li>
              <p class="step-date">{step.date}</p>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </li>
          ))}
        </ol>

        <aside class="next-read">
          <p class="next-read-context">{c.roadmap.live_manifest_text.split(":")[0]}.</p>
          <a class="next-read-link" href={c.links.roadmap}>
            Read our roadmap
            <span class="next-read-arrow" aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </section>

    <!-- ============ PILOT CTA ============ -->
    <section class="pilot-cta" aria-labelledby="pilot-heading" data-animate="up">
      <div class="container container-prose">
        <p class="section-eyebrow">{c.hospitals.eyebrow}</p>
        <h2 id="pilot-heading" class="section-heading">{c.hospitals.heading}</h2>
        <div class="prose">
          {c.hospitals.intro_paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="pilot-bullets" data-animate-stagger>
          {c.hospitals.pilot_bullets.map((b) => <li>{b}</li>)}
        </ul>
        <a href="/pilots" class="btn btn-primary" style="margin-top: 8px;">{c.hospitals.cta}</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* ============ ENTRANCE ============ */
  @keyframes wake {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .wake { opacity: 0; animation: wake 1.2s cubic-bezier(.2,.6,.2,1) forwards; }
  .wake-1 { animation-delay: 0.05s; }
  .wake-2 { animation-delay: 0.35s; }
  .wake-3 { animation-delay: 0.6s; }

  /* Fraunces SOFT-axis morph on entrance (variable-font signature move) */
  @keyframes soft-morph {
    from { font-variation-settings: "SOFT" 30,  "opsz" 144; }
    to   { font-variation-settings: "SOFT" 100, "opsz" 144; }
  }
  .soften { animation: soft-morph 0.8s cubic-bezier(.3,.6,.2,1) 0.7s both; }

  @media (prefers-reduced-motion: reduce) {
    .wake { animation: none; opacity: 1; transform: none; }
    .soften { animation: none; font-variation-settings: "SOFT" 100, "opsz" 144; }
  }

  /* ============ LAYOUT ============ */
  .container { max-width: 1160px; margin: 0 auto; padding: 0 32px; }
  /* Narrower reading column. No padding of its own — it is always either
     nested inside a .container (hero) or combined onto one (.container
     .container-prose), and in both cases the .container supplies the
     horizontal padding. Declaring padding:0 here used to override that
     and flush the section content against the viewport edge on mobile. */
  .container-prose { max-width: 720px; }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding: 96px 0 80px;
    overflow: hidden;
  }
  .ambient-trace {
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 220px;
    pointer-events: none;
    z-index: 0;
    opacity: var(--trace-opacity);
    overflow: hidden;
    /* Soft fade-in/out at the left/right edges so the trace dissolves into the
       page rather than hard-clipping at the viewport edge. */
    -webkit-mask-image: linear-gradient(to right,
      transparent 0,
      black 14%,
      black 86%,
      transparent 100%);
            mask-image: linear-gradient(to right,
      transparent 0,
      black 14%,
      black 86%,
      transparent 100%);
  }
  /* Each twisted pair gets its own scroll layer at its own duration. Within a
     single layer the loop is mathematically seamless (path is periodic over
     VIS_W, transform shifts by exactly VIS_W); across layers the differing
     durations make the relative phasing drift, so the combined braid keeps
     evolving instead of resetting. */
  .pair-scroller {
    position: absolute;
    inset: 0;
    width: 200%;
    height: 100%;
    animation-name: hero-trace-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  .pair-scroller svg { width: 100%; height: 100%; display: block; }
  @keyframes hero-trace-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pair-scroller { animation: none; }
  }
  /* Per-strand stroke / width / opacity are inlined from the strands[] array
     in frontmatter — keeps the visual depth tunable from one place. */
  .ambient-trace path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .hero-content { position: relative; z-index: 1; }

  h1.display {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(40px, 5.8vw, 76px);
    line-height: 1.03;
    letter-spacing: -0.024em;
    color: var(--ink);
    /* 22ch lets text-wrap: balance land on 2 lines at desktop widths
       (e.g. "Hospital-grade vital signs / from $44 of WiFi hardware.")
       instead of the awkward 3-line break at 16ch. */
    max-width: 22ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 144;
    /* Tightened from 260px so primary CTAs sit above the fold on
       1440×900. The ambient waveform still has room (it lives in the
       absolute-positioned .ambient-trace, centered vertically). */
    margin: 0 0 180px 0;
  }
  h1.display em {
    font-style: italic;
    font-weight: 500;
    color: var(--ink);
  }

  .lede {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 44px 0;
    text-wrap: pretty;
  }

  .cite-link {
    color: inherit;
    text-decoration: underline dotted var(--rule);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 220ms ease-out, color 220ms ease-out;
  }
  .cite-link:hover, .cite-link:focus-visible {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }
  .cite-link:visited { color: inherit; }
  .cite-link:visited:hover { color: var(--accent-visited); }

  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 4px;
    transition: background-color 180ms ease-out, color 180ms ease-out, border-color 180ms ease-out;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
  }
  .btn-primary { background: var(--accent); color: var(--paper); border: 1px solid var(--accent); }
  .btn-primary:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .btn-secondary { background: transparent; color: var(--accent); border: 1px solid transparent; }
  .btn-secondary:hover { color: var(--accent-2); }
  .btn-secondary:visited { color: var(--accent-visited); }

  /* ============ PROOF ============ */
  .proof {
    padding: 120px 0;
    border-top: 1px solid var(--rule);
  }
  .section-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 32px;
  }
  h2.section-heading {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 96;
    margin: 0 0 40px 0;
  }
  h2.section-heading em {
    font-style: italic;
    font-weight: 500;
    color: var(--muted);
    font-variation-settings: "SOFT" 100, "opsz" 96;
  }
  .section-lede {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 72px 0;
    text-wrap: pretty;
  }

  .comparison { margin: 0 0 56px 0; }
  .comparison-row {
    display: grid;
    grid-template-columns: 2fr 2fr 1.2fr 1.2fr;
    gap: 24px;
    align-items: baseline;
    padding: 28px 24px;
    border-bottom: 1px solid var(--rule);
    transition: background-color 180ms ease-out;
    margin: 0 -24px;
  }
  .comparison-row:hover { background: var(--row-hover); }
  .comparison-row:first-child { border-top: 1px solid var(--rule); }
  .row-name {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30, "opsz" 28;
  }
  .row-name .cite {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--muted);
    margin-left: 8px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .row-hardware {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 15px;
    color: var(--ink-2);
  }
  .row-cost, .row-mae {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 15px;
    color: var(--ink-2);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* Featured row (ViFi) — background fill, accent left stripe, all values
     in ink color so the row reads as THE result, not just one option. */
  .comparison-row.featured {
    background: var(--paper-2);
    position: relative;
  }
  .comparison-row.featured::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
  }
  .comparison-row.featured:hover { background: var(--paper-3); }
  .comparison-row.featured .row-name .featured-mark {
    font-style: italic;
    font-variation-settings: "SOFT" 80, "opsz" 28;
    color: var(--ink);
  }
  .comparison-row.featured .row-hardware,
  .comparison-row.featured .row-mae,
  .comparison-row.featured .row-cost {
    color: var(--ink);
    font-weight: 500;
  }

  /* "Next-read" — the editorial continuation pattern used at the end of
     Proof and Roadmap. Hairline above separates it from the body it
     summarizes; italic context line on the left holds the descriptor
     ("Full methodology, captures, and per-session breakdowns."); a
     deliberate sans-serif link on the right is the destination. The
     arrow nudges right on hover so the affordance is unmistakable. */
  .next-read {
    margin: 56px 0 0 0;
    padding: 28px 0 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px 56px;
    align-items: baseline;
  }
  .next-read-context {
    font-family: "Source Serif 4", Georgia, serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink-2);
    margin: 0;
    max-width: 50ch;
    text-wrap: pretty;
  }
  .next-read-link {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color 180ms ease-out, border-color 180ms ease-out;
  }
  .next-read-arrow {
    display: inline-block;
    font-family: "Source Serif 4", Georgia, serif;
    font-style: normal;
    transition: transform 220ms cubic-bezier(.2,.6,.2,1);
  }
  .next-read-link:hover .next-read-arrow,
  .next-read-link:focus-visible .next-read-arrow {
    transform: translateX(4px);
  }
  .next-read-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .next-read-link:visited {
    color: var(--accent-visited);
    border-bottom-color: var(--accent-visited);
  }
  @media (max-width: 600px) {
    .next-read {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* Comparison caption: distills the table's math into one sentence */
  .comparison-caption {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 70ch;
    margin: 32px 0;
    text-wrap: pretty;
  }
  .comparison-caption strong {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Stat callout (Problem section): three stacked rows, each row puts the big
     number and its caption on the same line, baseline-aligned. */
  .stat-callout {
    display: flex;
    flex-direction: column;
    margin: 40px 0 48px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat-cell {
    display: flex;
    align-items: baseline;
    gap: 28px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .stat-cell:last-child { border-bottom: none; }
  .stat-num {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
