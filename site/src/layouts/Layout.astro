---
import { ViewTransitions } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

// Self-hosted variable fonts per DESIGN.md. Astro inlines the @font-face
// declarations from these imports into the page CSS and ships the font
// binaries from /_astro/ — no Google CDN, no FOIT, no third-party request.
// Full files for Fraunces / Source Serif 4 expose all axes (wght, opsz,
// SOFT for Fraunces) so the variable-font moves keep working.
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter-tight/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ViFi — Hospital-grade vital signs from $44 of WiFi hardware",
  description = "Contactless WiFi-based vital-signs sensing. 4.15 bpm cross-session HR MAE validated against Polar H10 on $22 ESP32-S3 hardware. Pre-clearance research prototype.",
} = Astro.props;

const url = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "https://vifi.health";
---

<!doctype html>
<html lang="en" class="bg-paper text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="vifi.health" />
    <meta property="og:image" content="https://vifi.health/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="vifi.health — Hospital-grade vital signs from $44 of WiFi hardware. Validated: 4.15 bpm cross-session HR MAE." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://vifi.health/og-image.png" />
    <meta name="twitter:image:alt" content="vifi.health — Hospital-grade vital signs from $44 of WiFi hardware. Validated: 4.15 bpm cross-session HR MAE." />

    <!-- Fonts self-hosted via @fontsource-variable (imported in frontmatter). -->

    <ViewTransitions />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ViFi",
      "alternateName": "ViFi Health",
      "url": "https://vifi.health",
      "logo": "https://vifi.health/logo-monogram.svg",
      "description": "Contactless WiFi-based vital-signs sensing on $22 ESP32-S3 hardware. Pre-clearance research prototype.",
      "founder": { "@type": "Person", "name": "Zach Popowitz" },
      "foundingDate": "2026",
      "sameAs": ["https://github.com/Zpopowitz"]
    })} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style is:global>
  /* ============ DESIGN.md TOKENS — light (default) ============ */
  :root {
    --paper:        #F4EFE4;
    --paper-2:      #ECE5D5;
    --paper-3:      #E0D8C4;
    --ink:          #1A1A1A;
    --ink-2:        #3A3A3A;
    --muted:        #5A5A5A;
    --rule:         #D8D0BF;
    --accent:       #1D5C6E;
    --accent-2:     #2A7A92;
    --accent-visited: #3A4F73;
    --signal:       #0E9F66;
    --signal-glow:  #34D399;
    --trace:        var(--muted);
    --trace-opacity: 0.42;
    --row-hover:    rgba(26, 26, 26, 0.025);
  }

  /* ============ DESIGN.md TOKENS — dark ============ */
  @media (prefers-color-scheme: dark) {
    :root {
      --paper:        #131715;
      --paper-2:      #1C211D;
      --paper-3:      #252A26;
      --ink:          #E8E4D8;
      --ink-2:        #C8C2B0;
      --muted:        #8A8478;
      --rule:         #2D3330;
      --accent:       #4DA3BA;
      --accent-2:     #6EBED4;
      --accent-visited: #8B9FB8;
      --signal:       #2EBB7D;
      --signal-glow:  #34D399;
      --trace:        var(--ink-2);
      --trace-opacity: 0.30;
      --row-hover:    rgba(232, 228, 216, 0.035);
    }
  }

  @media (prefers-contrast: more) {
    :root { --muted: #2A2A2A; --rule: #6A6A6A; --trace-opacity: 0.65; }
    @media (prefers-color-scheme: dark) {
      :root { --muted: #DDDDDD; --rule: #888888; }
    }
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
    color-scheme: light dark;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: "Source Serif 4", Georgia, serif;
    font-optical-sizing: auto;
    font-size: 17px;
    line-height: 1.55;
    text-rendering: optimizeLegibility;
    transition: background-color 240ms ease-out, color 240ms ease-out;
  }

  /* Custom selection — brand carries when researchers highlight quotes */
  ::selection { background: var(--accent); color: var(--paper); }

  /* Global a11y */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 18px;
    border-radius: 0 0 4px 0;
    z-index: 100;
    text-decoration: none;
  }
  .skip-link:focus { left: 0; top: 0; }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Legacy ECG-trace styles preserved for any pages still using .ecg-trace */
  .ecg-trace path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    mix-blend-mode: screen;
    animation: ecg-sweep 5s linear infinite;
    animation-delay: 1s;
  }
  .ecg-trace path:nth-child(2) { animation-delay: 3.5s; }
  @keyframes ecg-sweep {
    0%   { stroke-dashoffset: 100; }
    85%  { stroke-dashoffset: 0; }
    90%  { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ecg-trace path { animation: none; stroke-dashoffset: 0; }
  }
</style>

<script>
  // Scroll-reveal observer (existing pattern, preserved)
  const setupScrollReveal = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate-in");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -10% 0px" }
    );
    document
      .querySelectorAll("[data-animate]:not(.animate-in)")
      .forEach((el) => observer.observe(el));
  };
  document.addEventListener("astro:page-load", setupScrollReveal);
</script>

<style is:global>
  [data-animate] {
    opacity: 0;
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  [data-animate="left"]  { transform: translateX(-3rem); }
  [data-animate="right"] { transform: translateX(3rem);  }
  [data-animate="up"]    { transform: translateY(2rem);  }

  [data-animate].animate-in {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
