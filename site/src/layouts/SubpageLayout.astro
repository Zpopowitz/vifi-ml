---
// Editorial Lab subpage layout — drives /results, /roadmap, /privacy, /terms.
// Asymmetric 2-column grid: section meta (eyebrow + heading) sticks in a
// left rail while body content flows in a wider right rail. Same pattern as
// Anthropic model cards, Stripe docs, Linear docs — reads as a designed
// document, not a centered markdown render.
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Block {
  type: "paragraph" | "subheading" | "bulleted_list" | "ordered_list" | "table";
  text?: string;
  items?: string[];
  headers?: string[];
  rows?: string[][];
}

interface Section {
  id?: string;
  eyebrow?: string;
  heading: string;
  blocks: Block[];
}

interface Props {
  page: {
    meta: { title: string; description: string };
    title: string;
    intro?: string;
    sections: Section[];
  };
}

const { page } = Astro.props;

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function renderInline(text: string): string {
  const codeSpans: string[] = [];
  let s = escapeHtml(text).replace(/`([^`]+)`/g, (_m, code) => {
    codeSpans.push(code);
    return ` CODE${codeSpans.length - 1} `;
  });

  s = s.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    (_m, label, href) => `<a href="${href}">${label}</a>`,
  );
  s = s.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  s = s.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, "$1<em>$2</em>");

  s = s.replace(/ CODE(\d+) /g, (_m, i) => `<code>${codeSpans[Number(i)]}</code>`);
  return s;
}

function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-");
}

// Pre-compute slugs once so the section rail can render anchors
const sectionsWithSlugs = page.sections.map((s) => ({
  ...s,
  slug: s.id ?? slugify(s.heading),
}));
---

<Layout title={`${page.meta.title} — ViFi`} description={page.meta.description}>
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="subpage-hero">
      <div class="container">
        <div class="hero-content">
          <p class="eyebrow">{page.meta.title}</p>
          <h1 class="display">{page.title}</h1>
          {page.intro && <p class="intro">{page.intro}</p>}
        </div>
      </div>
    </section>

    <!-- ============ SECTIONS (asymmetric 2-column) ============ -->
    {sectionsWithSlugs.map((section) => (
      <section id={section.slug} class="subpage-section" data-animate="up">
        <div class="container">
          <div class="section-grid">
            <header class="section-header">
              {section.eyebrow && <p class="section-eyebrow">{section.eyebrow}</p>}
              <h2 class="section-heading">
                <a href={`#${section.slug}`} class="anchor-link" aria-label={`Link to ${section.heading}`}>
                  {section.heading}
                </a>
              </h2>
            </header>

            <div class="section-body">
              {section.blocks.map((b) => {
                if (b.type === "paragraph" && b.text) {
                  return <p set:html={renderInline(b.text)} />;
                }
                if (b.type === "subheading" && b.text) {
                  return <h3>{b.text}</h3>;
                }
                if (b.type === "bulleted_list" && b.items) {
                  return (
                    <ul data-animate-stagger>
                      {b.items.map((it) => <li set:html={renderInline(it)} />)}
                    </ul>
                  );
                }
                if (b.type === "ordered_list" && b.items) {
                  return (
                    <ol data-animate-stagger>
                      {b.items.map((it) => <li set:html={renderInline(it)} />)}
                    </ol>
                  );
                }
                if (b.type === "table" && b.headers && b.rows) {
                  return (
                    <div class="table-wrap">
                      <table class="editorial-table">
                        <thead>
                          <tr>
                            {b.headers.map((h) => (
                              <th set:html={renderInline(h)} />
                            ))}
                          </tr>
                        </thead>
                        <tbody data-animate-stagger>
                          {b.rows.map((row) => (
                            <tr>
                              {row.map((cell, ci) => (
                                <td
                                  class={ci === 0 ? "first-col" : ""}
                                  set:html={renderInline(cell)}
                                />
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  );
                }
                return null;
              })}
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- ============ BACK ============ -->
    <section class="subpage-back">
      <div class="container">
        <a href="/" class="back-link" aria-label="Back to vifi.health home">
          <svg class="back-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M19 12H5M12 19l-7-7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="back-label">Back to</span>
          <span class="back-brand">
            <svg class="back-mark" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
              <path d="M 50 60 L 100 200 L 130 200 L 180 60 L 145 60 L 115 135 L 85 60 Z" fill="currentColor"/>
              <g fill="none" stroke-width="14" stroke-linecap="round" class="signal-arc">
                <path d="M 175 95 A 50 50 0 0 1 175 165"/>
                <path d="M 195 110 A 30 30 0 0 1 195 150"/>
              </g>
            </svg>
            <span class="back-wordmark">vifi<span class="dot">.</span>health</span>
          </span>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding: 0 40px; }

  /* ============ HERO ============ */
  .subpage-hero { padding: 96px 0 64px; }
  .hero-content { max-width: 820px; }
  .eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 28px;
  }
  h1.display {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 120;
    margin: 0 0 28px 0;
  }
  .intro {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    text-wrap: pretty;
  }

  /* ============ SECTIONS — asymmetric 2-column ============ */
  .subpage-section {
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }
  .section-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
  }
  .section-header {
    position: sticky;
    top: 32px;
  }
  .section-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  h2.section-heading {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
    font-variation-settings: "SOFT" 30, "opsz" 48;
    margin: 0;
  }
  .anchor-link {
    color: inherit;
    text-decoration: none;
    transition: color 180ms;
  }
  .anchor-link:hover { color: var(--accent); }
  .anchor-link:visited { color: inherit; }
  .anchor-link:visited:hover { color: var(--accent); }

  /* ============ BODY CONTENT ============ */
  .section-body {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 720px;
  }
  .section-body > * + * { margin-top: 1.15em; }
  .section-body h3 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30, "opsz" 32;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }
  .section-body h3:first-child { margin-top: 0; }
  .section-body p {
    text-wrap: pretty;
  }
  .section-body strong { color: var(--ink); font-weight: 600; }
  .section-body em { font-style: italic; }
  .section-body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 180ms;
  }
  .section-body a:hover { text-decoration-color: var(--accent); }
  .section-body a:visited { color: var(--accent-visited); }
  .section-body code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.92em;
    background: var(--paper-2);
    color: var(--ink);
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--rule);
  }
  .section-body ul,
  .section-body ol {
    padding-left: 1.5em;
  }
  .section-body ul { list-style: none; }
  .section-body ul > li {
    position: relative;
    padding-left: 4px;
    margin-bottom: 0.5em;
  }
  .section-body ul > li::before {
    content: "·";
    position: absolute;
    left: -1.2em;
    top: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.4em;
    line-height: 1;
  }
  .section-body ol > li {
    margin-bottom: 0.5em;
    padding-left: 4px;
  }
  .section-body ol > li::marker {
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9em;
  }

  /* ============ EDITORIAL TABLE — full right-rail width ============ */
  .table-wrap {
    margin: 32px 0;
    overflow-x: auto;
    max-width: 100%;
  }
  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .editorial-table thead tr { border-bottom: 1px solid var(--rule); }
  .editorial-table th {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: left;
    padding: 14px 16px 14px 0;
  }
  .editorial-table td {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 15px;
    color: var(--ink-2);
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .editorial-table tbody tr:last-child td { border-bottom: none; }
  .editorial-table td.first-col {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    color: var(--ink);
    font-variation-settings: "SOFT" 30, "opsz" 22;
  }
  .editorial-table td code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.95em;
  }
  .editorial-table tbody tr {
    transition: background-color 180ms ease-out;
  }
  .editorial-table tbody tr:hover { background: var(--row-hover); }

  /* ============ BACK ============ */
  .subpage-back {
    padding: 72px 0 96px;
    border-top: 1px solid var(--rule);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px 16px 14px;
    margin-left: -20px; /* visually align text with container edge */
    border-radius: 4px;
    text-decoration: none;
    color: var(--muted);
    transition: color 220ms ease-out, background-color 220ms ease-out;
  }
  .back-link:hover,
  .back-link:focus-visible {
    color: var(--accent);
    background: var(--paper-2);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .back-arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--muted);
    transition: color 220ms ease-out, transform 280ms cubic-bezier(.2,.6,.2,1);
  }
  .back-link:hover .back-arrow,
  .back-link:focus-visible .back-arrow {
    color: var(--accent);
    transform: translateX(-5px);
  }
  .back-label {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    transition: color 220ms ease-out;
  }
  .back-link:hover .back-label,
  .back-link:focus-visible .back-label {
    color: var(--accent);
  }
  .back-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    transition: color 220ms ease-out;
  }
  .back-link:hover .back-brand,
  .back-link:focus-visible .back-brand {
    color: var(--accent);
  }
  .back-mark {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: inherit;
  }
  .back-mark .signal-arc { stroke: var(--signal); }
  .back-wordmark {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30, "opsz" 20;
  }
  .back-wordmark .dot { color: var(--signal); }

  @media (max-width: 480px) {
    .subpage-back { padding: 48px 0 64px; }
    .back-link { padding: 12px 16px 12px 12px; margin-left: -16px; gap: 10px; }
    .back-label { display: none; }
    .back-wordmark { font-size: 16px; }
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 960px) {
    .container { padding: 0 32px; }
    .section-grid {
      grid-template-columns: 280px 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 760px) {
    .subpage-hero { padding: 56px 0 40px; }
    .subpage-section { padding: 48px 0; }
    .section-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .section-header { position: static; }
    .section-body { max-width: 100%; }
    .table-wrap { margin: 24px 0; }
    .editorial-table th, .editorial-table td { padding: 10px 12px 10px 0; font-size: 13px; }
  }
</style>
