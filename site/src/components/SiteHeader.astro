---
// Editorial Lab header: monogram + wordmark on the left, minimal nav on the right.
// No sticky, no scroll-shrink, no mobile hamburger — at narrow widths the nav
// stacks below the brand. Honest to the zen aesthetic.
import { getEntry } from "astro:content";

const landing = await getEntry("landing", "main");
const c = landing.data;
---

<header class="site-header" transition:persist>
  <div class="container">
    <a href="/" class="brand" aria-label={`${c.nav.brand} — home`}>
      <svg class="brand-mark" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
        <path d="M 50 60 L 100 200 L 130 200 L 180 60 L 145 60 L 115 135 L 85 60 Z" fill="currentColor"/>
        <g class="signal-arc" fill="none" stroke-width="14" stroke-linecap="round">
          <path d="M 175 95 A 50 50 0 0 1 175 165"/>
          <path d="M 195 110 A 30 30 0 0 1 195 150"/>
        </g>
      </svg>
      <span class="brand-text">vifi<span class="dot">.</span>health</span>
    </a>
    <nav class="primary-nav" aria-label="Primary">
      {c.nav.items.filter((i) => i.href !== "/").map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 28px 0;
  }
  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .brand:hover { color: var(--accent); }
  .brand-mark {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--ink);
  }
  .brand-mark .signal-arc { stroke: var(--signal); }
  .brand-text {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30, "opsz" 21;
  }
  .brand-text .dot { color: var(--signal); }

  .primary-nav { display: flex; gap: 28px; flex-wrap: wrap; }
  .primary-nav a {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .primary-nav a:hover { color: var(--accent); }
  .primary-nav a:visited { color: var(--muted); }
  .primary-nav a:visited:hover { color: var(--accent-visited); }

  @media (max-width: 480px) {
    .container {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .primary-nav { gap: 16px; }
    .primary-nav a { font-size: 13px; }
  }
</style>
