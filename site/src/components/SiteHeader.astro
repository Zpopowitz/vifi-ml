---
// Editorial Lab header — sticky, monogram + wordmark + nav + theme toggle.
// Stays accessible while scrolling: transparent at top, hairline rule +
// backdrop blur when scrolled. Home link explicit in the nav.
import { getEntry } from "astro:content";

const landing = await getEntry("landing", "main");
const c = landing.data;

// Match the current URL against each nav item for server-side aria-current.
// The client script below updates this on view transitions (header persists
// across navigations, so the server-rendered value alone would go stale).
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string): boolean {
  const norm = href.replace(/\/$/, "") || "/";
  if (norm === "/") return pathname === "/";
  return pathname === norm || pathname.startsWith(norm + "/");
}
---

<header class="site-header" transition:persist>
  <div class="container">
    <a href="/" class="brand" aria-label={`${c.nav.brand} home`}>
      <span class="brand-text">vifi<span class="dot">.</span><span class="tld">health</span></span>
    </a>

    <div class="header-right">
      <nav class="primary-nav" id="primary-nav" aria-label="Primary">
        {c.nav.items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle light/dark theme"
      >
        <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="menu-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // Theme toggle wiring (binds once, re-binds after view transitions)
    function getCurrentTheme() {
      var explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "dark" || explicit === "light") return explicit;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    function applyTheme(t) {
      // Suppress CSS transitions during the theme switch so the page
      // doesn't visibly fade through a desaturated mid-state. Without
      // this, .site-header (bg 200ms), body (bg+color 240ms), brand
      // (color 200ms), btn (bg+color+border 180ms), etc all animate
      // in parallel and the user sees a ~250ms wash where everything
      // is blending between light and dark values.
      var root = document.documentElement;
      root.classList.add("theme-switching");
      root.setAttribute("data-theme", t);
      try { localStorage.setItem("vifi-theme", t); } catch (_) {}
      // Force a paint with transitions disabled, then re-enable.
      // rAF×2 (next-frame, then next-next-frame) guarantees the new
      // colors have been laid down before transitions come back.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          root.classList.remove("theme-switching");
        });
      });
    }
    function bindToggle() {
      var btn = document.getElementById("theme-toggle");
      if (!btn || btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", function () {
        applyTheme(getCurrentTheme() === "dark" ? "light" : "dark");
      });
    }

    // Sticky-header scrolled state. Adds .scrolled class when window.scrollY > 8
    function onScroll() {
      var h = document.querySelector(".site-header");
      if (!h) return;
      if (window.scrollY > 8) h.classList.add("scrolled");
      else h.classList.remove("scrolled");
    }

    // Current-page indicator. Header persists across view transitions, so we
    // refresh aria-current on each astro:page-load instead of relying on the
    // server-rendered value alone.
    function updateCurrentNav() {
      var pathname = (window.location.pathname.replace(/\/$/, "") || "/");
      var links = document.querySelectorAll(".primary-nav a");
      for (var i = 0; i < links.length; i++) {
        var a = links[i];
        var href = (a.getAttribute("href") || "").replace(/\/$/, "") || "/";
        var active = href === "/"
          ? pathname === "/"
          : pathname === href || pathname.indexOf(href + "/") === 0;
        if (active) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      }
    }

    // Mobile menu. The hamburger toggles a .menu-open class on the header;
    // CSS drives the dropdown panel and the icon morph. The header persists
    // across view transitions, so bind once (dataset guard) and just reset
    // the open state on every astro:page-load.
    function closeMenu() {
      var header = document.querySelector(".site-header");
      var btn = document.getElementById("menu-toggle");
      if (header) header.classList.remove("menu-open");
      if (btn) {
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Open menu");
      }
    }
    function bindMenu() {
      var btn = document.getElementById("menu-toggle");
      var header = document.querySelector(".site-header");
      if (!btn || !header || btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var open = header.classList.toggle("menu-open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });
      // A nav choice dismisses the panel immediately, rather than waiting
      // for the view transition to land.
      header.querySelectorAll(".primary-nav a").forEach(function (a) {
        a.addEventListener("click", closeMenu);
      });
    }

    function setup() {
      bindToggle();
      onScroll();
      updateCurrentNav();
      bindMenu();
      closeMenu();
    }

    // Escape and outside-click both dismiss the mobile menu. Registered
    // once at script scope (the inline script runs once per full load).
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeMenu();
    });
    document.addEventListener("click", function (e) {
      var header = document.querySelector(".site-header");
      if (header && header.classList.contains("menu-open") && !header.contains(e.target)) {
        closeMenu();
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setup);
    } else {
      setup();
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:page-load", setup);
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 24px 0;
    background: var(--paper);
    transition: padding 200ms ease-out,
                background-color 200ms ease-out,
                border-color 200ms ease-out,
                backdrop-filter 200ms ease-out;
    border-bottom: 1px solid transparent;
  }
  /* Scrolled state: hairline rule + slight translucency + backdrop blur.
     Quiet treatment — the header reads as "still there" without dominating. */
  .site-header.scrolled {
    padding: 14px 0;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    backdrop-filter: blur(10px) saturate(1.1);
    border-bottom-color: var(--rule);
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  /* ============ WORDMARK BRAND ============ */
  .brand {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .brand:hover { color: var(--accent); }
  .brand-text {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variation-settings: "SOFT" 30, "opsz" 28;
  }
  /* The accent dot — emerald signal, slightly larger than the base type so
     it reads as a deliberate punctuation moment rather than a domain period. */
  .brand-text .dot {
    color: var(--signal);
    font-weight: 600;
    margin: 0 1px;
  }
  /* The .health suffix in italic — separates "brand" (vifi) from "domain
     scope" (health) typographically. Variable-font SOFT axis bumped so the
     italic reads softer than the upright. */
  .brand-text .tld {
    font-style: italic;
    font-weight: 500;
    font-variation-settings: "SOFT" 80, "opsz" 28;
  }
  .brand:hover .dot { color: var(--accent); }

  .header-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .primary-nav { display: flex; gap: 14px; flex-wrap: wrap; }
  .primary-nav a {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 4px;
    transition: color 200ms ease-out, background-color 200ms ease-out;
  }
  .primary-nav a:hover { color: var(--accent); }
  .primary-nav a:visited { color: var(--muted); }
  .primary-nav a:visited:hover { color: var(--accent-visited); }
  /* Current-page highlight — paper-3 pill (one step deeper than the
     surrounding paper-2 nav region) plus a quiet accent underline. The
     underline carries the brand teal so the indicator reads even when
     the pill background is subtle on a tinted hero. */
  .primary-nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-3);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .primary-nav a[aria-current="page"]:hover {
    color: var(--accent);
    background: var(--paper-3);
  }

  /* ============ THEME TOGGLE ============ */
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 3px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--muted);
    transition: color 180ms ease-out, border-color 180ms ease-out;
    padding: 0;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .icon {
    width: 16px;
    height: 16px;
    display: block;
  }
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-sun { display: block; }
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-moon { display: none; }
  }

  /* ============ MOBILE MENU TOGGLE ============ */
  /* Hidden on desktop, where the horizontal nav is shown. Squared to
     match .theme-toggle so the two read as a deliberate pair. */
  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 3px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--muted);
    padding: 0;
    transition: color 180ms ease-out, border-color 180ms ease-out;
  }
  .menu-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .menu-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    /* Same easing as the page's scroll-reveal motion — the icon morph
       reads as part of the site's zen flow, not a separate gesture. */
    transition: transform 220ms cubic-bezier(.2,.6,.2,1),
                opacity 140ms ease-out;
  }
  .menu-icon span:nth-child(1) { top: 0; }
  .menu-icon span:nth-child(2) { top: 50%; transform: translateY(-50%); }
  .menu-icon span:nth-child(3) { bottom: 0; }
  /* Open state: the three bars fold into an X. */
  .site-header.menu-open .menu-icon span:nth-child(1) {
    transform: translateY(5.25px) rotate(45deg);
  }
  .site-header.menu-open .menu-icon span:nth-child(2) { opacity: 0; }
  .site-header.menu-open .menu-icon span:nth-child(3) {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .container { padding: 0 20px; }
    .header-right { gap: 10px; }
    .menu-toggle { display: inline-flex; }

    /* 44px touch targets on mobile. Desktop keeps the compact 34px icon
       buttons and the 24px wordmark — those are pointer targets, not
       thumb targets. The icons inside stay their original size. */
    .brand { padding: 10px 0; }
    .theme-toggle,
    .menu-toggle { width: 44px; height: 44px; }

    /* Nav collapses into a dropdown panel pinned under the header. It is
       positioned against the sticky .site-header, so it spans the full
       header width and drops from its bottom edge. Hidden and
       non-focusable (visibility) until .menu-open. */
    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 2px;
      padding: 8px 20px 16px;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 200ms ease-out,
                  transform 200ms cubic-bezier(.2,.6,.2,1),
                  visibility 0s linear 200ms;
    }
    .site-header.menu-open .primary-nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 200ms ease-out,
                  transform 200ms cubic-bezier(.2,.6,.2,1),
                  visibility 0s;
    }
    /* Full-width tap rows; the aria-current pill still applies. */
    .primary-nav a {
      display: block;
      width: 100%;
      font-size: 15px;
      padding: 12px;
    }
  }

  @media (max-width: 760px) and (prefers-reduced-motion: reduce) {
    .primary-nav,
    .site-header.menu-open .primary-nav { transition: visibility 0s; }
    .menu-icon span { transition: none; }
  }
</style>
