---
import { getEntry } from "astro:content";

const landing = await getEntry("landing", "main");
const c = landing.data;
---

<footer transition:persist class="border-t border-slate-800 bg-ink px-6 py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 text-sm text-slate-500 md:flex-row md:justify-between"
  >
    <div class="space-y-2">
      <p class="font-semibold text-paper">{c.footer.disclaimer_title}</p>
      <p class="max-w-prose">{c.footer.disclaimer_body}</p>
    </div>
    <div class="space-y-1 md:text-right">
      <p>{c.footer.copyright}</p>
      <p>
        <a href={`mailto:${c.links.contact_email}`} class="hover:text-paper">
          {c.links.contact_email}
        </a>
      </p>
      <p class="flex flex-wrap gap-x-3 md:justify-end">
        {c.links.linkedin && (
          <>
            <a
              href={c.links.linkedin}
              target="_blank"
              rel="noopener"
              class="hover:text-paper"
            >
              LinkedIn
            </a>
            <span aria-hidden="true">·</span>
          </>
        )}
        <a href="/privacy" class="hover:text-paper">Privacy</a>
        <span aria-hidden="true">·</span>
        <a href="/terms" class="hover:text-paper">Terms</a>
      </p>
    </div>
  </div>
</footer>
