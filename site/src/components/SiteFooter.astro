---
import { getEntry } from "astro:content";

const landing = await getEntry("landing", "main");
const c = landing.data;
---

<footer class="site-footer" transition:persist>
  <div class="container">
    <p class="disclaimer">{c.footer.disclaimer_title} {c.footer.disclaimer_body}</p>
    <div class="meta">
      <p class="contact">
        <a href={`mailto:${c.links.contact_email}`}>{c.links.contact_email}</a>
        {c.links.linkedin && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <a href={c.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </>
        )}
        <span class="sep" aria-hidden="true">·</span>
        <a href="/privacy">Privacy</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/terms">Terms</a>
      </p>
      <p class="copyright">{c.footer.copyright}</p>
    </div>
    <p class="colophon">vifi.health<span class="sep">·</span>v0.6.0</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 80px;
    border-top: 1px solid var(--rule);
    margin-top: 0;
  }
  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .disclaimer {
    font-family: "Source Serif 4", Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: var(--muted);
    max-width: 65ch;
    margin-bottom: 28px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .contact, .copyright {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
  .contact a {
    color: var(--accent);
    text-decoration: none;
    transition: color 180ms;
  }
  .contact a:hover { color: var(--accent-2); }
  .contact a:visited { color: var(--accent-visited); }
  .sep { color: var(--rule); margin: 0 8px; }
  .copyright { color: var(--muted); }
  .colophon {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .colophon .sep { color: var(--rule); margin: 0 8px; }

  /* Mobile container padding — matches the 20px used site-wide so the
     footer content lines up with the header and page sections. */
  @media (max-width: 760px) {
    .container { padding: 0 20px; }
    /* 13px footer links sit in a ~20px line box — too small to tap
       reliably. Flex blockifies the links so vertical padding builds a
       44px touch target; the dot separators center against them. */
    .contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 2px;
    }
    .contact a { padding: 12px 0; }
    .contact .sep { margin: 0 6px; }
  }
  @media (max-width: 600px) {
    .meta { flex-direction: column; gap: 8px; }
  }
</style>
