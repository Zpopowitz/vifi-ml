# ViFi live monitoring stack -- environment for the systemd services.
#
# tools/setup_live_stack.sh installs this to /etc/vifi/live.env (and will not
# clobber an existing copy). All four services read it via EnvironmentFile.
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# shell quoting.

# Message bus. Redis runs on the Pi loopback only (see C4 in the SP1 spec).
VIFI_BUS_URL=redis://localhost:6379/0

# Patient id -- namespaces every bus topic (csi.raw.<id>, hr.reference.<id>,
# hr.predicted.<id>, ...). Must match the --subject-id capture.sh publishes as.
VIFI_PATIENT_ID=founder

# Per-stream entry cap, applied at publish time by the loggers + inference
# worker. SIZE THIS BY PAYLOAD, NOT JUST TIME: a CSI packet is ~1 KB but a
# radar IQ frame is ~50-100 KB, so the old 120000 default allowed multi-GB
# streams on a radar host (the 2026-06-10 outage). 12000 covers ~2 min of
# 90 Hz CSI and ~10 min of 20 fps radar in well under 1 GB of redis memory;
# every consumer window (60 s RR, 15 s radar HR) fits with wide margin.
# Redis here is transport, not storage (appendonly no): nothing in these
# streams is durable state. The audit JSONL on disk is the durable record.
VIFI_BUS_MAXLEN=12000

# The inference worker serves the real (trained-on-real-captures) model
# only -- there is no synthetic fallback. The model artifacts must be on
# the Pi before vifi-inference will come up; see docs/STATUS.md "sync from
# laptop". Override the location with VIFI_REAL_MODEL_DIR if not models_real/.

# Radar (SP2). The collector runs --source ftdi: raw ADC complex IQ over the
# C232HM-DDHSL-0 / FT232H SPI cable (the only source the DACM DSP can extract
# HR from -- the USB TLV stream is magnitude-only). While the units are
# installed but the cable is not connected, vifi-radar-collector will fail
# loudly (pyftdi cannot open the FT232H) and systemd will Restart=always
# retry -- expected, harmless. The default URL picks the first FT232H on the
# host; set this only if more than one FTDI device is attached.
# VIFI_RADAR_FTDI_URL=ftdi://ftdi:232h/1
# Data UART path -- only used for --source usb (TLV debugging, not vitals).
# VIFI_RADAR_PORT=/dev/serial/by-id/usb-Texas_Instruments_XDS110__08.02.04.00__M0_S0_...
# Chirp profile for the automated bring-up (tools/radar_bringup.sh runs
# reset + arm before the collector starts and sensorStart after; needs
# pyocd, pinned under the capture extra). Default: the repo copy.
# VIFI_RADAR_CFG=/home/zpopowitz/vifi-ml/deploy/radar/MotionDetect.cfg
# Seconds ExecStartPost waits for the collector to open the FTDI before
# sensorStart (default 5).
# VIFI_RADAR_POST_DELAY_S=5
# Slow-time frame rate the DSP assumes. The worker reads this as its
# --frame-rate default. 20 matches the solved SPI capture profile
# (framePeriodicity=50); 100 is the legacy per-chirp model and yields NaN HR
# on the bursty SPI stream (docs/RADAR_HR_FINDINGS_2026-05-29.md).
VIFI_RADAR_FRAME_RATE_HZ=20

# Auth mode. `none` is correct for the SP1 bench: every client is on the Pi
# loopback or the trusted LAN. SP7 (ops hardening) flips this to `api_key`
# and sets VIFI_API_KEYS / VIFI_REDIS_PASSWORD / TLS. See docs/LIVE_STACK.md.
VIFI_AUTH_MODE=none
