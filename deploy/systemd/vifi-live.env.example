# ViFi live monitoring stack -- environment for the systemd services.
#
# tools/setup_live_stack.sh installs this to /etc/vifi/live.env (and will not
# clobber an existing copy). All four services read it via EnvironmentFile.
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# shell quoting.

# Message bus. Redis runs on the Pi loopback only (see C4 in the SP1 spec).
VIFI_BUS_URL=redis://localhost:6379/0

# Patient id -- namespaces every bus topic (csi.raw.<id>, hr.reference.<id>,
# hr.predicted.<id>, ...). Must match the --subject-id capture.sh publishes as.
VIFI_PATIENT_ID=founder

# Per-stream entry cap, applied at publish time by the loggers + inference
# worker. 120000 entries is roughly 22 min of 90 Hz CSI before old entries
# are trimmed; AOF keeps in-flight data across a reboot.
VIFI_BUS_MAXLEN=120000

# Inference model. `synthetic` always works -- it ships with the repo and
# lets the stack come up cleanly out of the box. `real` scores CSI with the
# trained model and needs models_real/ (or models/) artifacts synced to the
# Pi first (see docs/STATUS.md "sync from laptop"). Flip to `real` once the
# artifacts exist, then `systemctl restart vifi-inference`.
VIFI_INFERENCE_MODEL=synthetic

# Auth mode. `none` is correct for the SP1 bench: every client is on the Pi
# loopback or the trusted LAN. SP7 (ops hardening) flips this to `api_key`
# and sets VIFI_API_KEYS / VIFI_REDIS_PASSWORD / TLS. See docs/LIVE_STACK.md.
VIFI_AUTH_MODE=none
