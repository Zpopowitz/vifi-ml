# ViFi off-site backup config (WP5) -- copy to a path OUTSIDE the repo and
# `source` it before running tools/backup_dataset.sh. NEVER commit the filled-in
# version: it points at the encrypted vault.
#
#   cp deploy/backup.env.example ~/.config/vifi/backup.env
#   $EDITOR ~/.config/vifi/backup.env      # fill in the blanks
#   source ~/.config/vifi/backup.env
#   ./tools/backup_dataset.sh init         # one-time
#   ./tools/backup_dataset.sh backup

# --- Destination (recommended: Backblaze B2 -- cheapest for this size) -------
# Create a B2 bucket + an application key scoped to it, then:
export RESTIC_REPOSITORY="b2:CHANGE-ME-bucket-name:vifi-dataset"
export B2_ACCOUNT_ID="CHANGE-ME-keyID"
export B2_ACCOUNT_KEY="CHANGE-ME-applicationKey"

# Alternatives (uncomment one instead of B2):
#   export RESTIC_REPOSITORY="s3:s3.amazonaws.com/CHANGE-ME-bucket/vifi-dataset"
#   export AWS_ACCESS_KEY_ID="..."; export AWS_SECRET_ACCESS_KEY="..."
#   export RESTIC_REPOSITORY="rclone:gdrive:vifi-dataset"   # needs rclone configured

# --- Repo passphrase ---------------------------------------------------------
# The passphrase file is NOT in the repo. The passphrase ALSO lives in the
# founder's password manager -- losing it loses the backup permanently.
export RESTIC_PASSWORD_FILE="$HOME/.config/vifi/restic.pass"

# --- Optional: include the consent ledger in the backup ----------------------
# Point at the off-repo ledger/link store if you want it backed up too.
# export VIFI_CONSENT_LEDGER="$HOME/.config/vifi/consent_ledger.csv"
